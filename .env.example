# URL atau PATH ke file database, default-nya: "file:./data/database.sqlite3"
DB_URL=file:./data/database.sqlite3


# Root direktori untuk semua data pengguna (uploads, ttd, dinas-luar, sounds,
# csrf-origins). Default di Windows: %LOCALAPPDATA%\Rapkumer-data; selain itu: <cwd>/data.
# Catatan Windows (instalasi via installer): nilai ini selalu dipaksa ulang oleh
# peluncur (start-rapkumer.mjs) setiap start. Ubah lewat halaman /pengaturan →
# "Lokasi Data", yang menulis ke %LOCALAPPDATA%\Rapkumer-data\data-root.txt.
RAPKUMER_DATA_DIR=


# Lokasi untuk menyimpan foto (format: file:<absolute-or-relative-path>).
# Kosongkan agar default ke <dataRoot>/uploads.
# Catatan: tidak ada UI untuk ini — uploads/sounds otomatis mengikuti root data.
# Nilai di sini hanya sebagai override manual tingkat lanjut.
# Contoh Windows: photo=file:C:\Users\User\AppData\Local\Rapkumer-data\uploads
photo=file:./data/uploads


# Lokasi untuk menyimpan file sound bell (format: file:<absolute-or-relative-path>).
# Kosongkan agar default ke <dataRoot>/sounds.
# Catatan: tidak ada UI untuk ini — uploads/sounds otomatis mengikuti root data.
# Nilai di sini hanya sebagai override manual tingkat lanjut.
# Contoh Windows: sounds=file:C:\Users\User\AppData\Local\Rapkumer-data\sounds
sounds=file:./data/sounds


# Path ke binary Chrome/Chromium untuk rendering PDF via PagedJS + Puppeteer.
# Jika tidak diisi, akan otomatis mencari di lokasi umum.
# Contoh Linux: PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# Contoh Windows: PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=


# ==============================================================================
# Konfigurasi ZITADEL SSO (Scholargate)
# ==============================================================================
# Domain / Issuer URL ZITADEL Anda (tanpa trailing slash)
# Contoh: https://auth.smansage.sch.id atau https://your-instance.zitadel.cloud
ZITADEL_ISSUER=https://auth.smansage.sch.id

# Client ID dari aplikasi Web yang dibuat pada ZITADEL Management Console
# Contoh: 284729184719284719@smansage
ZITADEL_CLIENT_ID=

# Client Secret (opsional, kosongkan jika tipe aplikasi adalah PKCE / Public Web App)
ZITADEL_CLIENT_SECRET=

# URL Callback (Redirect URI) yang didaftarkan di ZITADEL Console
# Rapkumer akan menggunakan endpoint /api/auth/zitadel/callback
# Contoh Lokal: http://localhost:5174/api/auth/zitadel/callback
# Contoh Produksi: https://rapor.smansage.sch.id/api/auth/zitadel/callback
ZITADEL_REDIRECT_URI=http://localhost:5174/api/auth/zitadel/callback

# URL Redirect setelah Logout dari ZITADEL (Post Logout Redirect URI)
# Daftarkan URL ini juga di bagian "Post Logout Redirect URIs" pada ZITADEL Console
# Contoh Lokal: http://localhost:5174/login
# Contoh Produksi: https://rapor.smansage.sch.id/login
ZITADEL_POST_LOGOUT_REDIRECT_URI=http://localhost:5174/login

# Kustomisasi label teks tombol SSO pada halaman login (default: "Masuk dengan SSO")
SSO_BUTTON_TEXT=Masuk dengan SSO

# Status tombol SSO di halaman login (true = aktif, false = sembunyikan)
SSO_ENABLED=true
